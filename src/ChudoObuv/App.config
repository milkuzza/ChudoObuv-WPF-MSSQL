<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup useLegacyV2RuntimeActivationPolicy="true">
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <connectionStrings>
        <add name="ChudoObuv" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=ChudoObuv;Integrated Security=True;Connect Timeout=15;Application Name=ChudoObuv" providerName="System.Data.SqlClient"/>
    </connectionStrings>
</configuration>
