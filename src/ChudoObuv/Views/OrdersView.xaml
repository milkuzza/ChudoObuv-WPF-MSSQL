<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Управление заказами" Style="{StaticResource Heading}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="NewOrder" Content="Добавить заказ" Style="{StaticResource Primary}"/>
            <Button x:Name="DeleteOrder" Content="Удалить заказ"/>
            <Button x:Name="Refresh" Content="Обновить"/>
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="OrdersGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Заказ №" Binding="{Binding Id}" Width="90"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="140"/>
                <DataGridTextColumn Header="ФИО клиента" Binding="{Binding Customer}" Width="*" MinWidth="250"/>
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" x:Name="OrderTotal" FontSize="18" FontWeight="Bold" Margin="0,14,0,10"/>
        <DataGrid Grid.Row="4" x:Name="LinesGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Модель" Binding="{Binding Name}" Width="*" MinWidth="240"/>
                <DataGridTextColumn Header="Производство" Binding="{Binding Manufacturer}" Width="150"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size, StringFormat=0.#}" Width="75"/>
                <DataGridTextColumn Header="Пар" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="Цена, ₽" Binding="{Binding UnitPrice, StringFormat=N2}" Width="110"/>
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="5" x:Name="AdminPanel" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="Дата заказа:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="OrderDate" Width="145" Margin="0,0,10,0"/>
            <Button x:Name="SaveDate" Content="Сохранить дату"/>
            <Button x:Name="DeleteLine" Content="Удалить выбранную позицию"/>
        </StackPanel>
        <Button Grid.Row="6" x:Name="Back" Content="Назад к каталогу" HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </Grid>
</UserControl>
