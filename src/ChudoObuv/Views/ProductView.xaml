<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Модель обуви" Style="{StaticResource Heading}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <Image Source="{Binding Image}" Stretch="Uniform" Height="245"/>
                    <Border Background="{StaticResource Mint}" Padding="16" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding PriceText}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DiscountText}" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Available, StringFormat='Всего доступно: {0} пар'}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Manufacturer, StringFormat='Производство: {0}'}"/>
                    <TextBlock Text="{Binding Category, StringFormat='Категория: {0}'}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Subcategory, StringFormat='Тип обуви: {0}'}" Margin="0,5,0,0"/>
                    <TextBlock Text="Состав" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding Composition}"/>
                    <TextBlock Text="Описание" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding Description}"/>
                    <TextBlock Text="Размерный ряд модели" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="SizeRange"/>
                    <TextBlock Text="Доступный размер" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="SizeBox" DisplayMemberPath="Label"/>
                    <TextBlock Text="Количество пар (целое число от 1 до 10 000)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="QuantityBox" Text="1" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="AddHint" FontSize="13" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="Back" Content="Назад к каталогу"/>
            <Button x:Name="Add" Content="Добавить в корзину" Style="{StaticResource Primary}" Margin="0"/>
        </StackPanel>
    </Grid>
</UserControl>
