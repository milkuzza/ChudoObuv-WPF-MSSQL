<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="112"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Mint}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="Logo" Stretch="Uniform" Margin="0,0,18,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Чудо Обувь" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Каталог обуви" FontSize="17" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserName" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="UserRole" FontSize="13" HorizontalAlignment="Right" Margin="0,2,0,8"/>
                    <Button x:Name="LoginButton" HorizontalAlignment="Right" Padding="12,4" MinHeight="28" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="24,15,24,10">
            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="Обновить"/>
                    <Button x:Name="OrdersButton" Content="Заказы"/>
                    <Button x:Name="CartButton" Content="Корзина (0)" Style="{StaticResource Primary}" Margin="0"/>
                </StackPanel>
                <TextBlock x:Name="CountText" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel x:Name="FiltersPanel" Orientation="Horizontal">
                <StackPanel Width="330" Margin="0,0,14,0">
                    <TextBlock Text="Поиск по названию и описанию" Style="{StaticResource Label}"/>
                    <TextBox x:Name="SearchBox" ToolTip="Поиск обновляется при вводе"/>
                </StackPanel>
                <StackPanel Width="245" Margin="0,0,14,0">
                    <TextBlock Text="Категория" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>
                <StackPanel Width="245">
                    <TextBlock Text="Сортировка" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="SortBox" SelectedIndex="0">
                        <ComboBoxItem Content="По порядку каталога"/>
                        <ComboBoxItem Content="Цена: по возрастанию"/>
                        <ComboBoxItem Content="Цена: по убыванию"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" Margin="24,0,24,0">
            <ListBox x:Name="ProductsList" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" BorderBrush="#B8D5CB" BorderThickness="1" CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding LowStock}" Value="True"><Setter Property="Background" Value="#ff8080"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinHeight="145">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="3" Margin="0,0,18,0"><Image Source="{Binding Image}" Stretch="Uniform" Height="140"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Category}" FontSize="13" Foreground="#526B68"/>
                                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" Margin="0,4,0,8"/>
                                    <TextBlock Text="{Binding Manufacturer, StringFormat='Производство: {0}'}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Composition, StringFormat='Состав: {0}'}" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PriceText}" FontSize="23" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding OriginalPriceText}" Foreground="#526B68" TextDecorations="Strikethrough" FontSize="14">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDiscount}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DiscountText}" FontSize="13" Margin="0,3,0,12"/>
                                    <TextBlock Text="{Binding StockText, StringFormat='В наличии: {0}'}" FontWeight="Bold"/>
                                    <TextBlock Text="Выбрать модель →" FontSize="13" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="По заданным условиям ничего не найдено. Измените поиск или категорию." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
        </Grid>
        <Border Grid.Row="3" Background="#F4FAF7" Padding="24,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="StatusText" FontSize="13" Text=""/>
        </Border>
    </Grid>
</UserControl>
